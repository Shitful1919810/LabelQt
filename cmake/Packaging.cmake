if(NOT UNIX OR APPLE)
    return()
endif()

set(CPACK_PACKAGE_NAME "labelqt")
set(CPACK_PACKAGE_VENDOR "Shitful")
set(CPACK_PACKAGE_CONTACT "shitful233@gmail.com")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "${PROJECT_DESCRIPTION}")
set(CPACK_PACKAGE_DESCRIPTION
    "LabelQt is a Qt 6 desktop editor for LabelPlus manga translation projects.\nIt provides page management, proofreading comparison and automation support."
)
set(CPACK_PACKAGE_HOMEPAGE_URL "${PROJECT_HOMEPAGE_URL}")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_RESOURCE_FILE_LICENSE "${CMAKE_CURRENT_SOURCE_DIR}/LICENSE.txt")
set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")
set(CPACK_PACKAGE_RELOCATABLE OFF)
set(CPACK_PACKAGE_CHECKSUM "SHA256")
set(CPACK_STRIP_FILES TRUE)

set(LABELQT_PRERELEASE "" CACHE STRING "Optional package prerelease label, for example alpha.4 or beta.1.")
set(LABELQT_PACKAGE_REVISION "1" CACHE STRING "Native package revision.")
set(LABELQT_RPM_DIST_TAG "" CACHE STRING "Optional RPM distribution tag without a leading dot, for example fc44.")
if(NOT LABELQT_PRERELEASE STREQUAL "" AND NOT LABELQT_PRERELEASE MATCHES "^(alpha|beta|rc)\.[0-9]+$")
    message(FATAL_ERROR "LABELQT_PRERELEASE must be empty or use alpha.N, beta.N or rc.N.")
endif()
if(NOT LABELQT_PACKAGE_REVISION MATCHES "^[0-9]+$")
    message(FATAL_ERROR "LABELQT_PACKAGE_REVISION must contain digits only.")
endif()
if(NOT LABELQT_RPM_DIST_TAG MATCHES "^[A-Za-z0-9.]*$")
    message(FATAL_ERROR "LABELQT_RPM_DIST_TAG may only contain ASCII letters, digits and dots.")
endif()

set(CPACK_GENERATOR "RPM")
if(LABELQT_ENABLE_EXPERIMENTAL_DEB_PACKAGE)
    list(APPEND CPACK_GENERATOR "DEB")
endif()

set(LABELQT_PACKAGE_DISPLAY_VERSION "${PROJECT_VERSION}")
set(LABELQT_RPM_RELEASE "${LABELQT_PACKAGE_REVISION}")
set(LABELQT_DEBIAN_VERSION "${PROJECT_VERSION}-${LABELQT_PACKAGE_REVISION}")
if(NOT LABELQT_PRERELEASE STREQUAL "")
    set(LABELQT_PACKAGE_DISPLAY_VERSION "${PROJECT_VERSION}-${LABELQT_PRERELEASE}")
    set(LABELQT_RPM_RELEASE "0.${LABELQT_PRERELEASE}.${LABELQT_PACKAGE_REVISION}")
    set(LABELQT_DEBIAN_VERSION "${PROJECT_VERSION}~${LABELQT_PRERELEASE}-${LABELQT_PACKAGE_REVISION}")
endif()
if(NOT LABELQT_RPM_DIST_TAG STREQUAL "")
    string(APPEND LABELQT_RPM_RELEASE ".${LABELQT_RPM_DIST_TAG}")
endif()
set(CPACK_PACKAGE_FILE_NAME "${CPACK_PACKAGE_NAME}-${LABELQT_PACKAGE_DISPLAY_VERSION}-${CMAKE_SYSTEM_PROCESSOR}")

set(LABELQT_DEBIAN_ARCHITECTURE "${CMAKE_SYSTEM_PROCESSOR}")
if(CMAKE_SYSTEM_PROCESSOR STREQUAL "x86_64" OR CMAKE_SYSTEM_PROCESSOR STREQUAL "AMD64")
    set(LABELQT_DEBIAN_ARCHITECTURE "amd64")
elseif(CMAKE_SYSTEM_PROCESSOR STREQUAL "aarch64")
    set(LABELQT_DEBIAN_ARCHITECTURE "arm64")
endif()

set(CPACK_DEBIAN_PACKAGE_MAINTAINER "Shitful <shitful233@gmail.com>")
set(CPACK_DEBIAN_PACKAGE_SECTION "graphics")
set(CPACK_DEBIAN_PACKAGE_PRIORITY "optional")
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE "${LABELQT_DEBIAN_ARCHITECTURE}")
set(CPACK_DEBIAN_PACKAGE_VERSION "${LABELQT_DEBIAN_VERSION}")
set(CPACK_DEBIAN_PACKAGE_HOMEPAGE "${CPACK_PACKAGE_HOMEPAGE_URL}")
set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)

set(CPACK_RPM_PACKAGE_LICENSE "MIT")
set(CPACK_RPM_PACKAGE_GROUP "Applications/Graphics")
set(CPACK_RPM_PACKAGE_AUTOREQ ON)
set(CPACK_RPM_PACKAGE_DESCRIPTION "${CPACK_PACKAGE_DESCRIPTION}")
set(CPACK_RPM_PACKAGE_RELEASE "${LABELQT_RPM_RELEASE}")
set(CPACK_RPM_PACKAGE_URL "${CPACK_PACKAGE_HOMEPAGE_URL}")
set(CPACK_RPM_FILE_NAME RPM-DEFAULT)
set(CPACK_RPM_SPEC_MORE_DEFINE "%define _tmppath ${CMAKE_BINARY_DIR}/_CPack_Packages/Linux/RPM/TMP")
set(CPACK_RPM_EXCLUDE_FROM_AUTO_FILELIST_ADDITION
    "/usr/share/applications"
    "/usr/share/icons"
    "/usr/share/icons/hicolor"
    "/usr/share/icons/hicolor/scalable"
    "/usr/share/icons/hicolor/scalable/apps"
)

include(CPack)
