find_package(Qt6 6.5 REQUIRED COMPONENTS Core Gui Concurrent)
if(LABELQT_BUILD_DESKTOP)
    find_package(Qt6 6.5 REQUIRED COMPONENTS Widgets OPTIONAL_COMPONENTS Svg)
    find_package(Qt6Keychain REQUIRED)
endif()
find_package(Qt6 6.5 QUIET OPTIONAL_COMPONENTS LinguistTools)
if(LABELQT_ENABLE_WINDOWS_STATIC_RELEASE)
    set(ZLIB_USE_STATIC_LIBS ON)
endif()
find_package(ZLIB REQUIRED)

