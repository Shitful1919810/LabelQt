if(LABELQT_REQUIRE_LINGUIST_TOOLS AND NOT Qt6LinguistTools_FOUND)
    message(FATAL_ERROR "Qt LinguistTools is required for this release build but was not found.")
endif()

qt_standard_project_setup()
